    "events": [
      {
        "eventId": "evt-1",
        "stableEventKey": "stable-evt-1",
        "source": "caption",
        "speaker": "Interviewer",
        "text": "Why do you want this job?",
        "time": "10:00",
        "timestamp": 1000,
        "sessionOffsetMs": 1000,
        "isFinal": true
      }
    ],
    "artifacts": {
      "summaries": {},
      "assistantState": {
        "enabled": true,
        "updatedAt": 900
      }
    }
  },
  "steps": [
    {
      "expectedPromptIncludes": [
        "Output language code: en",
        "Output language name: English",
