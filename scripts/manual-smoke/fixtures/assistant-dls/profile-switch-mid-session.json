{
  "id": "profile-switch-mid-session",
  "description": "Switching the active session profile mid-session changes assistant semantics for later outputs.",
  "initialDefaultProfileId": "interview",
  "initialSettingsPatch": {
    "meetingOutputLanguage": "en"
  },
  "initialProfilePatches": [
    {
      "profileId": "interview",
      "patch": {
        "assistant": {
          "enabledByDefault": true,
          "responseIntent": "answer_for_me",
          "triggerPolicy": "questions_requests_only",
          "participantScope": "others_only"
        }
      }
    },
    {
      "profileId": "client_call",
      "patch": {
        "assistant": {
          "enabledByDefault": true,
          "responseIntent": "surface_risks",
          "responseFormat": "talking_points",
          "responseDepth": "brief",
          "responseTone": "analytical",
          "deliveryBias": "balanced",
          "triggerPolicy": "salience_first",
          "participantScope": "others_only"
        }
      }
    }
  ],
  "steps": [
    {
      "type": "caption",
      "stableKey": "switch-q1",
      "speaker": "Interviewer",
      "text": "Tell me about your experience with microservices.",
      "settleMs": 3200
    },
    {
      "type": "switchSessionProfile",
      "profileId": "client_call",
      "propagationWaitMs": 1800
    },
    {
      "type": "caption",
      "stableKey": "switch-risk-1",
      "speaker": "Client",
      "text": "The biggest risk is that the migration will miss the release deadline.",
      "settleMs": 3200
    }
  ],
  "expectations": {
    "outputCount": 2,
    "overlayCardCount": 2,
    "liveState": "done",
    "latestOutputTriggerIncludes": "release deadline",
    "latestOutputProfileId": "client_call",
    "latestOutputResponseIntent": "surface_risks",
    "diagnosticsMessages": [
      "assistant_pass_completed"
    ],
    "settleTimeoutMs": 50000
  }
}
