# Copy this file to .secrets/smoke.env and fill values.
# This directory is excluded from git.

# OpenAI key used by smoke runners when a test needs runtime AI credentials.
OPENAI_API_KEY=<sample-token>

# Optional provider URL overrides for smoke scripts.
# GOOGLE_MEET_URL=
# TEAMS_URL=
# ZOOM_URL=

# Zoom scenario routing (all optional):
# ZOOM_HOME_URL=https://app.zoom.us/wc/home
# ZOOM_SCHEDULE_URL=https://app.zoom.us/meeting/schedule
# ZOOM_SCHEDULE_TOPIC=Test - Caption Arc
# ZOOM_SHARED_URL=
#   Used by `zoom-web meeting-shared` scenario, e.g.:
#   https://us05web.zoom.us/j/123...?pwd=...
