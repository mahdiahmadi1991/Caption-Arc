# Copy the relevant sections into these git-ignored local files:
# - .secrets/.env.local                for shared machine-local values
# - .secrets/.env.development.local    for development-only values
# - .secrets/.env.production.local     for production-only values
# This directory is excluded from git.

# Shared machine-local values.
# WXT_MICROSOFT_OAUTH_TENANT=common
# OPENAI_API_KEY=<sample-token>

# Development-only values.
# WXT_CHROME_EXTENSION_KEY_DEVELOPMENT=<base64-public-key>
# WXT_FIREFOX_EXTENSION_ID_DEVELOPMENT=<addon-id@example.com>
# WXT_GOOGLE_OAUTH_CLIENT_ID_CHROME=
# WXT_GOOGLE_OAUTH_CLIENT_SECRET_CHROME=
# WXT_MICROSOFT_OAUTH_CLIENT_ID_CHROME=

# Production-only values.
# WXT_CHROME_EXTENSION_KEY_PRODUCTION=<base64-public-key>
# WXT_FIREFOX_EXTENSION_ID_PRODUCTION=<addon-id@example.com>
# WXT_GOOGLE_OAUTH_CLIENT_ID_CHROME=
# WXT_GOOGLE_OAUTH_CLIENT_SECRET_CHROME=
# WXT_MICROSOFT_OAUTH_CLIENT_ID_CHROME=
# WXT_GOOGLE_OAUTH_CLIENT_ID_FIREFOX=
# WXT_GOOGLE_OAUTH_CLIENT_SECRET_FIREFOX=
# WXT_MICROSOFT_OAUTH_CLIENT_ID_FIREFOX=

# Optional shared fallbacks.
# WXT_CHROME_EXTENSION_KEY=<base64-public-key>
# WXT_FIREFOX_EXTENSION_ID=<addon-id@example.com>
# WXT_GOOGLE_OAUTH_CLIENT_ID=
# WXT_GOOGLE_OAUTH_CLIENT_SECRET=
# WXT_MICROSOFT_OAUTH_CLIENT_ID=

# OpenAI key used by smoke runners when a test needs runtime AI credentials.
# OPENAI_API_KEY=<sample-token>

# Optional provider URL overrides for smoke scripts.
# Put these in `.secrets/smoke.env`, not the build env files above.
# GOOGLE_MEET_URL=
# TEAMS_URL=
# ZOOM_URL=

# Zoom scenario routing (all optional):
# ZOOM_HOME_URL=https://app.zoom.us/wc/home
# ZOOM_SCHEDULE_URL=https://app.zoom.us/meeting/schedule
# ZOOM_SCHEDULE_TOPIC=Test - Caption Arc
# ZOOM_SHARED_URL=
#   Used by `zoom-web meeting-shared` scenario, e.g.:
#   https://us05web.zoom.us/j/123...?pwd=...
