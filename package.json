{
  "name": "caption-arc",
  "version": "1.1.0",
  "description": "Capture browser meeting captions with floating overlay and real-time translation",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "pnpm build:all:production",
    "build:extension": "pnpm build:chrome:production",
    "build:development": "pnpm build:all:development",
    "build:production": "pnpm build:all:production",
    "build:chrome:development": "wxt build -b chrome --mode development",
    "build:chrome:production": "wxt build -b chrome --mode production",
    "build:firefox:development": "wxt build -b firefox --mode development",
    "build:firefox:production": "wxt build -b firefox --mode production",
    "build:all:development": "pnpm build:chrome:development && pnpm build:firefox:development",
    "build:all:production": "pnpm build:chrome:production && pnpm build:firefox:production",
    "docs:check": "node ./scripts/docs/validate-docs.mjs",
    "zip": "pnpm zip:all:production",
    "zip:production": "pnpm zip:all:production",
    "zip:chrome:production": "wxt zip -b chrome --mode production",
    "zip:firefox:production": "wxt zip -b firefox --mode production",
    "zip:all:production": "pnpm zip:chrome:production && pnpm zip:firefox:production",
    "test": "pnpm test:google",
    "test:google": "vitest run tests/google-meet",
    "test:google:coverage": "vitest run tests/google-meet --coverage",
    "test:coverage": "pnpm test:google:coverage",
    "test:google:watch": "vitest tests/google-meet",
    "test:targeted:plan": "node ./scripts/testing/recommend-targeted-tests.mjs",
    "test:targeted:run": "node ./scripts/testing/recommend-targeted-tests.mjs --run",
    "test:module:plan": "node ./scripts/testing/recommend-targeted-tests.mjs --module-scope",
    "test:module:run": "node ./scripts/testing/recommend-targeted-tests.mjs --module-scope --run",
    "chrome:debug": "bash ./scripts/start-windows-chrome-debug.sh",
    "chrome:debug:reload": "bash ./scripts/start-windows-chrome-debug.sh",
    "chrome:debug:stop": "bash ./scripts/stop-windows-chrome-debug.sh",
    "chrome:debug:check": "node ./scripts/manual-smoke/check-cdp.mjs",
    "chrome:debug:ensure": "bash ./scripts/manual-smoke/ensure-cdp-ready.sh",
    "chrome:debug:diagnostics": "node ./scripts/manual-smoke/diagnostics-runtime.mjs get",
    "chrome:debug:diagnostics:stream": "node ./scripts/manual-smoke/stream-diagnostics-live.mjs",
    "chrome:debug:diagnostics:enable": "node ./scripts/manual-smoke/diagnostics-runtime.mjs enable",
    "chrome:debug:diagnostics:disable": "node ./scripts/manual-smoke/diagnostics-runtime.mjs disable",
    "chrome:debug:diagnostics:clear": "node ./scripts/manual-smoke/diagnostics-runtime.mjs clear",
    "chrome:debug:reload-extension": "node ./scripts/manual-smoke/reload-extension-runtime.mjs",
    "chrome:debug:check:windows": "bash ./scripts/manual-smoke/check-cdp-windows.sh",
    "chrome:debug:doctor": "bash ./scripts/manual-smoke/cdp-doctor.sh",
    "chrome:secrets:check": "bash ./scripts/manual-smoke/load-secrets-env.sh",
    "chrome:meet:url": "node ./scripts/manual-smoke/get-google-meet-url.mjs",
    "chrome:meet:url:lobby": "node ./scripts/manual-smoke/get-google-meet-url.mjs 9222 lobby",
    "chrome:seed:google:continuation": "node ./scripts/manual-smoke/seed-google-continuation.mjs",
    "chrome:smoke:meet": "bash ./scripts/manual-smoke/smoke-google-meet.sh",
    "chrome:smoke:meet:raw": "node ./scripts/manual-smoke/smoke-google-meet.mjs",
    "chrome:smoke:google:settings": "bash ./scripts/manual-smoke/smoke-google-overlay-settings.sh",
    "chrome:smoke:google:settings:fresh": "AUTO_BUILD_EXTENSION_ALWAYS=1 bash ./scripts/manual-smoke/smoke-google-overlay-settings.sh",
    "chrome:smoke:google:settings:raw": "node ./scripts/manual-smoke/smoke-google-overlay-settings.mjs",
    "chrome:smoke:provider": "bash ./scripts/manual-smoke/smoke-provider.sh",
    "chrome:smoke:provider:fresh": "AUTO_BUILD_EXTENSION_ALWAYS=1 bash ./scripts/manual-smoke/smoke-provider.sh",
    "chrome:smoke:provider:raw": "node ./scripts/manual-smoke/smoke-provider.mjs",
    "chrome:smoke:i18n": "bash ./scripts/manual-smoke/smoke-ui-i18n.sh",
    "chrome:smoke:i18n:fresh": "AUTO_BUILD_EXTENSION_ALWAYS=1 bash ./scripts/manual-smoke/smoke-ui-i18n.sh",
    "chrome:smoke:live": "DETERMINISTIC_TEST_MODE=1 SMOKE_LIVE_DIAGNOSTICS=1 bash ./scripts/manual-smoke/smoke-provider.sh",
    "chrome:smoke:live:fresh": "DETERMINISTIC_TEST_MODE=1 SMOKE_LIVE_DIAGNOSTICS=1 AUTO_BUILD_EXTENSION_ALWAYS=1 bash ./scripts/manual-smoke/smoke-provider.sh",
    "chrome:smoke:live:google:settings": "DETERMINISTIC_TEST_MODE=1 SMOKE_LIVE_DIAGNOSTICS=1 bash ./scripts/manual-smoke/smoke-google-overlay-settings.sh",
    "chrome:smoke:live:i18n": "DETERMINISTIC_TEST_MODE=1 SMOKE_LIVE_DIAGNOSTICS=1 SMOKE_LIVE_DIAGNOSTICS_MIN_LEVEL=trace SMOKE_DIAGNOSTICS_MIN_LEVEL=trace bash ./scripts/manual-smoke/smoke-ui-i18n.sh",
    "chrome:smoke:live:matrix": "DETERMINISTIC_TEST_MODE=1 SMOKE_LIVE_DIAGNOSTICS=1 bash ./scripts/manual-smoke/smoke-matrix.sh",
    "chrome:smoke:google:continuation": "bash ./scripts/manual-smoke/smoke-provider.sh google-meet continuation",
    "chrome:smoke:matrix": "bash ./scripts/manual-smoke/smoke-matrix.sh",
    "chrome:debug:bridge:setup": "bash ./scripts/manual-smoke/setup-wsl-cdp-bridge.sh",
    "chrome:debug:bridge:remove": "bash ./scripts/manual-smoke/remove-wsl-cdp-bridge.sh",
    "chrome:debug:bridge:show": "bash ./scripts/manual-smoke/show-wsl-cdp-bridge.sh",
    "postinstall": "wxt prepare"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-extension",
    "google-meet",
    "microsoft-teams",
    "zoom",
    "caption",
    "translation",
    "summarizer",
    "ai-assistant",
    "open-ai"
  ],
  "author": "Mohammad Mahdi Ahmadi",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.1.32",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.23",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "wxt": "^0.20.13"
  },
  "dependencies": {
    "lucide": "^1.7.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7"
  }
}
